<Project>
    <PropertyGroup>
        <ProductVersion>3.0.1</ProductVersion>
        <TargetFramework>net10.0</TargetFramework>

        <AvaloniaVersion>12.1.4</AvaloniaVersion>
        <AvaloniaDataGridVersion>12.1.2</AvaloniaDataGridVersion>
        <AsvAvaloniaVersion>3.1.1</AsvAvaloniaVersion>
        <AsvMavlinkVersion>4.4.3</AsvMavlinkVersion>
        <AsvGnssVersion>2.5.2</AsvGnssVersion>
        <AsvLauncherApiVersion>0.0.1</AsvLauncherApiVersion>

        <FileVersion>$(ProductVersion)</FileVersion>
        <Version>$(ProductVersion)</Version>
        <PackageVersion>$(ProductVersion)</PackageVersion>
        <Authors>https://github.com/asv-soft</Authors>
        <Company>https://github.com/asv-soft</Company>
        <Copyright>https://github.com/asv-soft</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>icon.png</PackageIcon>
        <PackageProjectUrl>https://github.com/asv-soft/asv-drones</PackageProjectUrl>
        <RepositoryUrl>https://github.com/asv-soft/asv-drones</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <LangVersion>preview</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)CodeStyle.ruleset</CodeAnalysisRuleSet>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <WarningsAsErrors
            Condition="!$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.Test'))"
        >
            CS0169,
            CS0618,
            CS1502,
            CS1503,
            CS8524,
            CS8600,
            CS8601,
            CS8602,
            CS8603,
            CS8604,
            CS8625,
            CS8629,
            CS8762,
            CA1510,
            CA1851
        </WarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Asv.Drones.Api' and '$(ApiVersion)' != ''">
        <FileVersion>$(ApiVersion)</FileVersion>
        <Version>$(ApiVersion)</Version>
        <PackageVersion>$(ApiVersion)</PackageVersion>
    </PropertyGroup>
    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)../assets/icon.png" Pack="true" PackagePath="/" Link="icon.png" />
    </ItemGroup>
</Project>
